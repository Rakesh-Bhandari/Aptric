# Aptric backend (Express on Vercel) — copy to backend/.env and fill in.
# Every variable below is read via process.env somewhere in backend/src.
# Despite the VITE_ prefix, the VITE_* names here are server-side only.

# ── Server ────────────────────────────────────────────────────
VITE_PORT=5000                          # local listen port (src/server.js)
VITE_NODE_ENV=development               # "production" enables secure/SameSite=None cookies
VITE_FRONTEND_URL=http://localhost:6969 # CORS allow-list, OAuth redirects, OpenRouter referer

# Optional: allow Vercel preview deployments of the frontend through CORS.
# Matches https://<FRONTEND_SLUG>-<hash>-<TEAM_SLUG>.vercel.app; disabled when TEAM_SLUG is empty.
VITE_FRONTEND_SLUG=aptric-bxno
VITE_VERCEL_TEAM_SLUG=

# ── Database (TiDB / MySQL) ───────────────────────────────────
VITE_DB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
VITE_DB_PORT=4000
VITE_DB_USER=
VITE_DB_PASSWORD=
VITE_DB_NAME=apti_db1
# Optional: base64 of the CA cert, used only when src/certs/isrgrootx1.pem is missing.
#   base64 -w0 src/certs/isrgrootx1.pem
TIDB_SSL_CERT=

# ── Auth ──────────────────────────────────────────────────────
# Required (server refuses to start without it). JWT signing secret. Generate with: openssl rand -base64 48
VITE_SESSION_SECRET=

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_REDIRECT_URI=http://localhost:5000/auth/login/callback

# ── Email (Gmail SMTP — use an App Password, not your account password) ──
EMAIL_USER=
EMAIL_PASS=

# ── Cloudinary (avatar uploads) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Rate limiting (Upstash Redis) ─────────────────────────────
# Optional: when either is empty, rate limiting falls back to in-memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cron ──────────────────────────────────────────────────────
# Vercel sends "Authorization: Bearer $CRON_SECRET" to /api/cron/*.
CRON_SECRET=

# ── AI question generation (OpenRouter) ───────────────────────
OPEN_ROUTER_API_KEY=
QUESTION_MODEL=google/gemini-2.0-flash-001   # generates questions
QUESTION_FALLBACK_MODEL=openai/gpt-4o-mini   # used when the primary call fails or returns bad JSON
QUESTION_VERIFY_MODEL=                       # solves each question independently; defaults to QUESTION_MODEL
QUESTION_AI_TIMEOUT_MS=25000                 # per-request timeout
GENERATION_JOB_BUDGET_MS=20000               # time budget per generation-jobs cron run
QUESTION_BANK_MIN_UNUSED=50                  # refill when unused questions drop below this
QUESTION_BANK_MAX_PER_RUN=20                 # max questions generated per difficulty per run
