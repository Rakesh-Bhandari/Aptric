# Aptric API (backend/) — copy to backend/.env for `npm run dev`, and set the
# same variables in the Vercel project for this folder. These are secrets:
# never commit the filled-in file or expose them to the browser.

# ── Supabase (database) ───────────────────────────────────────
# Dashboard > Project Settings > API Keys (and Data API for the URL).
# Project URL:
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key (sb_secret_...). The legacy service_role key also works. Never the
# publishable/anon key, and never in the frontend.
SUPABASE_SECRET_KEY=
# Local stack (`npx supabase status`): SUPABASE_URL=http://127.0.0.1:54321 and
# its "Secret key".

# ── URLs ──────────────────────────────────────────────────────
# The React app (email links and Google sign-in return to <FRONTEND_URL>/auth/callback).
FRONTEND_URL=http://localhost:6969
# Extra allowed CORS origins, comma-separated (e.g. a custom domain). `*` is a
# wildcard, e.g. https://aptric-*.vercel.app for Vercel preview deployments.
CORS_ORIGINS=
# This API's public URL (Google redirect URI = <API_URL>/auth/google/callback).
API_URL=http://localhost:5000
PORT=5000

# ── Sessions ──────────────────────────────────────────────────
# At least 32 random characters: `openssl rand -base64 48`.
JWT_SECRET=
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_DAYS=30
EMAIL_LINK_MINUTES=60

# ── Email (Google SMTP) ───────────────────────────────────────
# SMTP_USER is the Gmail / Google Workspace address that sends the emails;
# SMTP_PASS is an app password for it (Google Account > Security > 2-Step
# Verification > App passwords). Without SMTP_USER/SMTP_HOST, development
# builds print the links to the console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# true for port 465 (implicit TLS), false for 587 (STARTTLS). Defaults to port == 465.
# SMTP_SECURE=true
# SMTP_TIMEOUT_MS=10000
SMTP_USER=
SMTP_PASS=
# Must be SMTP_USER or a verified "Send mail as" alias, or Gmail rewrites it.
SMTP_FROM=Aptric <you@gmail.com>

# ── Google sign-in (optional) ─────────────────────────────────
# Google Cloud Console > Credentials > OAuth client (Web). Authorized redirect
# URI: <API_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI question generation (optional, admin only) ─────────────
OPEN_ROUTER_API_KEY=
# QUESTION_MODEL=google/gemini-2.5-flash
# QUESTION_VERIFY_MODEL=openai/gpt-4o-mini
# LLM_BASE_URL=https://openrouter.ai/api/v1
# Embeddings for near-duplicate checks: any OpenAI-compatible /embeddings API
# that returns 384 dimensions (text-embedding-3-* with `dimensions`).
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_BASE_URL=   (defaults to LLM_BASE_URL)
# EMBEDDING_API_KEY=    (defaults to OPEN_ROUTER_API_KEY)
# SITE_URL=             (sent to OpenRouter as HTTP-Referer; defaults to FRONTEND_URL)
# GENERATE_BATCH_SIZE=5
# GENERATE_REQUESTS_PER_MINUTE=20
# GENERATE_JOBS_PER_HOUR=10
# GENERATE_QUESTIONS_PER_DAY=300

# ── Aptric Tutor (AI chat on the solve screen) ────────────────
# Any OpenAI-compatible chat API. Defaults to OpenRouter with free models
# (ids ending in :free; others are skipped unless TUTOR_ALLOW_PAID_MODELS=true).
# Without a key the tutor answers 503 tutor_unavailable and the app falls back
# to the stored hint and explanation.
#   Groq (free tier):  TUTOR_LLM_BASE_URL=https://api.groq.com/openai/v1
#                      TUTOR_MODEL=llama-3.3-70b-versatile  TUTOR_FALLBACK_MODELS=llama-3.1-8b-instant
#   Ollama (local):    TUTOR_LLM_BASE_URL=http://localhost:11434/v1  (no key needed)
#                      TUTOR_MODEL=llama3.1  TUTOR_FALLBACK_MODELS=
# TUTOR_LLM_BASE_URL=   (defaults to LLM_BASE_URL, then OpenRouter)
# TUTOR_LLM_API_KEY=    (defaults to OPEN_ROUTER_API_KEY)
# TUTOR_MODEL=meta-llama/llama-3.3-70b-instruct:free
# TUTOR_FALLBACK_MODELS=deepseek/deepseek-chat-v3-0324:free,qwen/qwen-2.5-72b-instruct:free,mistralai/mistral-small-3.1-24b-instruct:free
# TUTOR_ALLOW_PAID_MODELS=false
# TUTOR_MAX_TOKENS=700
# TUTOR_TEMPERATURE=0.3
# TUTOR_MESSAGES_PER_HOUR=60
# TUTOR_MESSAGES_PER_DAY=200
