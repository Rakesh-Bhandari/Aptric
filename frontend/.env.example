# Aptric frontend (Vite) — copy to frontend/.env.local and fill in.
# Only VITE_* variables are exposed to the browser, and everything here ships
# in the client bundle: never put a secret here. Set the same values in Vercel.

# ── Supabase ──────────────────────────────────────────────────
# Dashboard > Project Settings > API Keys. The publishable (or legacy anon)
# key is safe to ship to the browser; never put the secret / service_role key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Local stack instead (`npx supabase start`, then `npx supabase status` for the key):
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_PUBLISHABLE_KEY=<publishable / anon key from `supabase status`>
