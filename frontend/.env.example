# Supabase project (Dashboard > Project Settings > API Keys). The publishable
# (or legacy anon) key is safe to ship to the browser; never put the secret /
# service_role key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# v1 Express API, still used by pages that haven't moved to Supabase yet.
VITE_API_BASE_URL=http://localhost:5000
