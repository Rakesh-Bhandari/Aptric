# Aptric frontend (Vite) — copy to frontend/.env.local and fill in.
# Only VITE_* variables are exposed to the browser, and everything here ships
# in the client bundle: never put a secret here. Set the same value in Vercel.

# ── API ───────────────────────────────────────────────────────
# The Aptric API (backend/). The browser talks only to this; the database
# (Supabase Postgres) is reached by the API, never directly.
VITE_API_URL=http://localhost:5000
# Production, e.g.:
# VITE_API_URL=https://aptric-api.vercel.app
